# Set these in Vercel project settings (Settings → Environment Variables)
# for production. For local development, copy this file to .env.local.

# Analytics provider: 'ga4' | 'plausible' | 'console' | 'none'
# Defaults: 'console' in dev, 'none' in production if unset.
VITE_ANALYTICS_PROVIDER=ga4

# Google Analytics 4 measurement ID — public, ships in page HTML by design.
VITE_GA4_ID=G-XXXXXXXXXX

# Plausible (only if VITE_ANALYTICS_PROVIDER=plausible)
# VITE_PLAUSIBLE_DOMAIN=calcmydehumidifier.com
